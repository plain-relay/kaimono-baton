+          2) ;;
+          3) printf '%s\n' '{"id":2,"result":{"thread":{"id":"thread-pilot"},"activePermissionProfile":{"id":"symphony-pilot","extends":null}}}' ;;
+          4) printf '%s\n' '{"id":3,"result":{"turn":{"id":"turn-pilot"}}}'; printf '%s\n' '{"method":"turn/completed"}'; exit 0 ;;
+        esac
+      done
+      """)
+      File.chmod!(codex_binary, 0o755)
+      write_workflow_file!(Workflow.workflow_file_path(), workspace_root: workspace_root, codex_command: "#{codex_binary} app-server")
+      workflow = File.read!(Workflow.workflow_file_path())
+      File.write!(Workflow.workflow_file_path(), String.replace(workflow, "  thread_sandbox:", "  permission_profile: symphony-pilot\n  thread_sandbox:"))
+
+      issue = %Issue{
