+      refute Map.has_key?(thread["params"], "sandbox")
+      assert turn["params"]["permissions"] == "symphony-pilot"
+      assert turn["params"]["environments"] == []
+      assert turn["params"]["title"] == "GH-6"
+      refute Map.has_key?(turn["params"], "sandboxPolicy")
+      encoded = Jason.encode!(turn)
