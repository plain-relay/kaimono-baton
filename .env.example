# The feature stays hidden unless all three public settings are present.
VITE_HANDWRITING_IMPORT_ENABLED=false
VITE_HANDWRITING_DIAGNOSTICS_ENABLED=false
VITE_HANDWRITING_IMPORT_ENDPOINT=https://your-worker.example.workers.dev/
VITE_TURNSTILE_SITE_KEY=replace-with-public-site-key

# Product photos and live requests remain unpublished until separately approved.
VITE_PRODUCT_PHOTOS_ENABLED=false
VITE_LIVE_REQUESTS_ENABLED=false
VITE_MANUAL_VALIDATION_ENABLED=false
